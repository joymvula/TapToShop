<resources>
    <!-- Base application theme -->
    <style name="Theme.Tap2Shop" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/purple_700</item>

        <!-- Remove this line completely: <item name="bottomNavigationViewStyle">@style/Widget.Tap2Shop.BottomNavigation</item> -->
    </style>

    <!-- Keep this style but don't reference it in theme -->
    <style name="Widget.Tap2Shop.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemHorizontalTranslationEnabled">true</item>
        <item name="itemRippleColor">@color/purple_200</item>
    </style>

    <!-- Full screen activities (splash, full screen dialogs) -->
    <style name="Theme.Tap2Shop.Fullscreen" parent="Theme.Tap2Shop">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>



</resources>

