<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.tap2shop">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tap2Shop">

        <!-- No intent-filter, can be exported false (default if not needed externally) -->
        <activity
            android:name=".ui.checkout.OrderConfirmationActivity"
            android:exported="false" />

        <activity
            android:name=".ui.checkout.CheckoutActivity"
            android:exported="false" />

        <activity
            android:name=".ui.cart.CartActivity"
            android:exported="false" />

        <activity
            android:name=".ui.product.ProductDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.orders.MyOrdersActivity"
            android:exported="false" />

        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ui.LoginActivity"
            android:exported="false" />

        <!-- Launcher activity: must be exported = true -->
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

    </application>

</manifest>
